    "detector = FaceDetector(model_path=\"./weights/Alignment_RetinaFace.pth\", device=device)\n",
    "\n",
    "for image_path in glob.glob(\"./dataset/images/*.jpg\"):\n",
    "    _, determinants = detector.get_face(image_path)\n",
    "\n",
    "    if len(determinants) == 0:\n",
    "        print(\"No faces detected.\")\n",
    "    else:\n",
    "        draw.draw_faces_on_image(image_path, determinants)"
   ]
  },
  {
   "cell_type": "code",
